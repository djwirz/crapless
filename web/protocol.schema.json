{
  "$defs": {
    "BetKind": {
      "enum": [
        "pass",
        "pass_odds",
        "come",
        "come_odds",
        "place"
      ],
      "title": "BetKind",
      "type": "string"
    },
    "Hello": {
      "additionalProperties": false,
      "description": "The first message on a connection.",
      "properties": {
        "type": {
          "const": "hello",
          "type": "string"
        },
        "v": {
          "type": "integer"
        },
        "token": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{12,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 12,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "v",
        "token",
        "table",
        "name"
      ],
      "title": "Hello",
      "type": "object"
    },
    "LastRoll": {
      "additionalProperties": false,
      "properties": {
        "die1": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "die2": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "settlements": {
          "items": {
            "$ref": "#/$defs/SettlementView"
          },
          "type": "array"
        }
      },
      "required": [
        "die1",
        "die2",
        "settlements"
      ],
      "title": "LastRoll",
      "type": "object"
    },
    "Leave": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "leave",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Leave",
      "type": "object"
    },
    "OthersOnSpot": {
      "additionalProperties": false,
      "properties": {
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "seats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "spot",
        "seats"
      ],
      "title": "OthersOnSpot",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "win",
        "lose",
        "returned",
        "moved"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "PassDice": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pass",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "roll": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "roll"
      ],
      "title": "PassDice",
      "type": "object"
    },
    "Pedantic": {
      "additionalProperties": false,
      "description": "Switch pedantic mode on or off for your own seat.",
      "properties": {
        "type": {
          "const": "pedantic",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "on"
      ],
      "title": "Pedantic",
      "type": "object"
    },
    "PlaceBet": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bet",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "amount": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        },
        "roll": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "spot",
        "amount",
        "roll"
      ],
      "title": "PlaceBet",
      "type": "object"
    },
    "PlayerView": {
      "additionalProperties": false,
      "properties": {
        "seat": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "integer"
        },
        "bankroll": {
          "type": "integer"
        },
        "away": {
          "type": "boolean"
        },
        "shooter": {
          "type": "boolean"
        },
        "pedantic": {
          "type": "boolean"
        },
        "net": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seat",
        "name",
        "color",
        "bankroll",
        "away",
        "shooter",
        "pedantic",
        "net"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "Refill": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "refill",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Refill",
      "type": "object"
    },
    "Refused": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rejected",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "code",
        "reason"
      ],
      "title": "Refused",
      "type": "object"
    },
    "RollDice": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "roll",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "roll": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "roll"
      ],
      "title": "RollDice",
      "type": "object"
    },
    "SettlementView": {
      "additionalProperties": false,
      "properties": {
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "amount": {
          "type": "integer"
        },
        "paid": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        }
      },
      "required": [
        "spot",
        "outcome",
        "amount",
        "paid",
        "returned"
      ],
      "title": "SettlementView",
      "type": "object"
    },
    "Spot": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/BetKind"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "number"
      ],
      "title": "Spot",
      "type": "object"
    },
    "SpotView": {
      "additionalProperties": false,
      "properties": {
        "spot": {
          "$ref": "#/$defs/Spot"
        },
        "amount": {
          "type": "integer"
        },
        "step": {
          "type": "integer"
        },
        "low": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "high": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "removable": {
          "type": "boolean"
        },
        "working": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "spot",
        "amount",
        "step",
        "low",
        "high",
        "removable",
        "working"
      ],
      "title": "SpotView",
      "type": "object"
    },
    "State": {
      "additionalProperties": false,
      "description": "One player's view of the whole table, sent after every change. Replace what you had.",
      "properties": {
        "type": {
          "const": "state",
          "type": "string"
        },
        "v": {
          "type": "integer"
        },
        "token": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "you": {
          "type": "string"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "announcement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bankroll": {
          "type": "integer"
        },
        "point": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "roll": {
          "type": "integer"
        },
        "roll_blocked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_ms": {
          "type": "integer"
        },
        "can_refill": {
          "type": "boolean"
        },
        "low_on_chips": {
          "type": "boolean"
        },
        "can_pass": {
          "type": "boolean"
        },
        "leave_blocked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerView"
          },
          "type": "array"
        },
        "spots": {
          "items": {
            "$ref": "#/$defs/SpotView"
          },
          "type": "array"
        },
        "others": {
          "items": {
            "$ref": "#/$defs/OthersOnSpot"
          },
          "type": "array"
        },
        "last_roll": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastRoll"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "v",
        "token",
        "table",
        "ref",
        "you",
        "notice",
        "announcement",
        "ack",
        "bankroll",
        "point",
        "roll",
        "roll_blocked",
        "wait_ms",
        "can_refill",
        "low_on_chips",
        "can_pass",
        "leave_blocked",
        "players",
        "spots",
        "others",
        "last_roll"
      ],
      "title": "State",
      "type": "object"
    },
    "Working": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "working",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "working": {
          "type": "boolean"
        },
        "roll": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "number",
        "working",
        "roll"
      ],
      "title": "Working",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only for generating the schema: one of each direction.",
  "properties": {
    "client": {
      "discriminator": {
        "mapping": {
          "bet": "#/$defs/PlaceBet",
          "hello": "#/$defs/Hello",
          "leave": "#/$defs/Leave",
          "pass": "#/$defs/PassDice",
          "pedantic": "#/$defs/Pedantic",
          "refill": "#/$defs/Refill",
          "roll": "#/$defs/RollDice",
          "working": "#/$defs/Working"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/PlaceBet"
        },
        {
          "$ref": "#/$defs/Working"
        },
        {
          "$ref": "#/$defs/RollDice"
        },
        {
          "$ref": "#/$defs/Pedantic"
        },
        {
          "$ref": "#/$defs/Refill"
        },
        {
          "$ref": "#/$defs/PassDice"
        },
        {
          "$ref": "#/$defs/Leave"
        }
      ]
    },
    "server": {
      "discriminator": {
        "mapping": {
          "rejected": "#/$defs/Refused",
          "state": "#/$defs/State"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/State"
        },
        {
          "$ref": "#/$defs/Refused"
        }
      ]
    }
  },
  "required": [
    "client",
    "server"
  ],
  "title": "Protocol",
  "type": "object"
}
